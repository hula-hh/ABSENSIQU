const SHEETS={STUDENTS:"Students",ATTENDANCE:"Attendance"};
function doGet(){return out({ok:true,service:"ABSENSIQU API"})}
function doPost(e){try{const b=JSON.parse(e.postData.contents||"{}");if(b.action==="getStudents")return out({ok:true,data:read(SHEETS.STUDENTS)});if(b.action==="getAttendance")return out({ok:true,data:read(SHEETS.ATTENDANCE)});if(b.action==="addStudent"){if(duplicateStudent(b.student))return out({ok:false,error:"NISN already exists"});append(SHEETS.STUDENTS,b.student);return out({ok:true})}if(b.action==="addAttendance"){if(duplicateAttendance(b.attendance))return out({ok:false,error:"Attendance already exists"});append(SHEETS.ATTENDANCE,b.attendance);return out({ok:true})}return out({ok:false,error:"Unknown action"})}catch(err){return out({ok:false,error:String(err)})}}
function read(name){const s=SpreadsheetApp.getActive().getSheetByName(name);if(!s)return[];const v=s.getDataRange().getValues();if(v.length<2)return[];return v.slice(1).filter(r=>r.join("")!=="").map(r=>{const o={};v[0].forEach((h,i)=>o[h]=r[i]);return o})}
function append(name,obj){const s=SpreadsheetApp.getActive().getSheetByName(name);if(!s)throw Error("Sheet "+name+" not found");const h=s.getRange(1,1,1,s.getLastColumn()).getValues()[0];s.appendRow(h.map(k=>obj[k]??""))}
function duplicateStudent(st){return read(SHEETS.STUDENTS).some(x=>String(x.nis)===String(st.nis))}
function duplicateAttendance(a){return read(SHEETS.ATTENDANCE).some(x=>String(x.date)===String(a.date)&&String(x.subject)===String(a.subject)&&String(x.studentId)===String(a.studentId))}
function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}